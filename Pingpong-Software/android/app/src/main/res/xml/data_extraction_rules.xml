<?xml version="1.0" encoding="utf-8"?>
<!--
  ROBUSTNESS/SECURITY FIX (2026-08-14 Android production audit): the app had
  android:allowBackup="true" with NO scoping at all — Android's default
  auto-backup would sweep the WebView's data directory (cookies, localStorage,
  IndexedDB) into cloud backup / device-to-device transfer. That directory is
  exactly where the Firebase session and PingPong login state live, so an
  unscoped backup could carry a logged-in session onto a different device
  during a "restore from backup" flow — not encrypted end-to-end the way the
  login flow itself is. Excluding the WebView data directory here means a
  restored install starts logged-out and re-authenticates normally instead.
  This is Android 12+'s (API 31+) backup config format; see backup_rules.xml
  for the pre-12 equivalent, both referenced from AndroidManifest.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WebView"/>
        <exclude domain="file" path="app_webview"/>
        <exclude domain="database" path="app_webview"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WebView"/>
        <exclude domain="file" path="app_webview"/>
        <exclude domain="database" path="app_webview"/>
    </device-transfer>
</data-extraction-rules>
